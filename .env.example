# Copy to .env. These are all the settings the app reads (constitution Art. V.5).
# The values below are for `docker compose up`.
#
# Running on the host (`npm run dev` / `npm run start`)? Next.js also reads
# .env.local, which compose ignores. Put the host values there:
#   OLLAMA_BASE_URL=http://localhost:11434
#   PROFILES_DIR=./profiles
# Both read the same profiles; `npm run dev` only adds hot reload.

# Ollama endpoint, as seen from the container.
OLLAMA_BASE_URL=http://host.docker.internal:11434

# Model used for every pipeline step.
OLLAMA_MODEL=qwen3.5:27b-int4

# Per-call timeout in milliseconds (large models are slow).
OLLAMA_TIMEOUT_MS=1800000

# Context window in tokens, sent with every call. Prompts or replies that don't
# fit fail with a clear error instead of being silently truncated. Larger values
# use more memory while the model is loaded.
OLLAMA_NUM_CTX=16384

# Thinking mode for models that have one (true or false). Unset uses the model's
# default. false is much faster but may judge less carefully.
# OLLAMA_THINK=false

# Folder holding the profile folders, inside the container. Compose always sets
# this to /app/profiles, bind-mounted from ./profiles.
PROFILES_DIR=/app/profiles

# Web UI port.
PORT=3000
