# Copy to .env. These are all the settings the app reads (constitution Art. V.5).
# `npm run dev` and `npm run start` read the same file; dev only adds hot reload.

# Ollama endpoint. Ollama runs on this machine.
OLLAMA_BASE_URL=http://localhost:11434

# Model used for every pipeline step.
OLLAMA_MODEL=qwen3.5:27b-int4

# How long a model call may stay silent, in milliseconds. It restarts with every
# token, so a model that is still thinking or writing is never cut off.
OLLAMA_TIMEOUT_MS=1800000

# Context window in tokens, sent with every call. Prompts or replies that don't
# fit fail with a clear error instead of being silently truncated. Larger values
# use more memory while the model is loaded.
OLLAMA_NUM_CTX=16384

# Thinking mode for models that have one (true or false). Unset uses the model's
# default. false is much faster but may judge less carefully.
# OLLAMA_THINK=false

# Folder holding the profile folders.
PROFILES_DIR=./profiles

# The port is not read from this file: Next.js picks it before loading it.
# Use `npm run dev -- -p 3001` (or `npm run start -- -p 3001`) for another port.
