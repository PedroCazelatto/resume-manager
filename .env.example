# Copy to .env before `npm run dev` or `npm run start`. Both run the app in
# Docker Compose. These are all the settings the app reads (constitution Art. V.5).

# Ollama endpoint, as seen from the container.
OLLAMA_BASE_URL=http://host.docker.internal:11434

# Model used for every pipeline step.
OLLAMA_MODEL=qwen3.5:27b

# Per-call timeout in milliseconds (large models are slow).
OLLAMA_TIMEOUT_MS=600000

# Data folder inside the container. Compose always sets this to /app/data, mounted
# from ./data (`npm run start`) or ./data.example (`npm run dev`).
DATA_DIR=/app/data

# Web UI port.
PORT=3000
