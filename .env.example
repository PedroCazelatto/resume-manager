# Copy to .env before `docker compose up`. These are all the settings the app
# reads (constitution Art. V.5).
#
# Running `npm run dev` outside Docker? Put overrides in .env.local, e.g.
#   OLLAMA_BASE_URL=http://localhost:11434
#   DATA_DIR=./data.example

# Ollama endpoint, as seen from the container.
OLLAMA_BASE_URL=http://host.docker.internal:11434

# Model used for every pipeline step.
OLLAMA_MODEL=qwen3.5:27b

# Per-call timeout in milliseconds (large models are slow).
OLLAMA_TIMEOUT_MS=600000

# Data folder inside the container. Compose always sets this to /app/data,
# bind-mounted from ./data.
DATA_DIR=/app/data

# Web UI port.
PORT=3000
